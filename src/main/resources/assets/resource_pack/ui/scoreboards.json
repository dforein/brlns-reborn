{
  "namespace": "scoreboard",

  "scoreboard_sidebar_score": {
    "text": "",
    "shadow": true,
    "text_alignment": "right",
    "size": [ "default", "default" ],
    "inherit_max_sibling_width": true
  },

  "scoreboard_sidebar_player": {
    "shadow": true,
    "text_alignment": "left",
    "size": [ "default", "default" ],
    "max_size": [ "default", "default" ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "inherit_max_sibling_width": true
  },

  "scoreboard_sidebar": {
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ "-28%", "-19.5%" ],
    "ignored": "$scoreboards_feature_disabled",
    "bindings": [
      {
        "binding_name": "#scoreboard_sidebar_visible",
        "binding_type": "global",
        "binding_name_override": "#visible"
      }
    ]
  },

  "scoreboard_sidebar/main": {
    "alpha": 0.0,
    "bindings": [],
    "size": [ "100%cm", "100%c" ]
  },

  "scoreboard_sidebar/main/displayed_objective": {
    "visible": false
  },

  "scoreboard_sidebar/main/lists": {
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  "scoreboard_sidebar/main/lists/horizontal_padding": {
    "ignored": true
  },

  "scoreboard_sidebar/main/lists/scores": {
    "use_child_anchors": false
  },

  "scoreboard_sidebar/displayed_objective_background": {
    "ignored": true
  }
}